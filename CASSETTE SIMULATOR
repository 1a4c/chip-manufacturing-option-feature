  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // =====================================================================
      // 1. Rust Core Logic Ported to JS State Machine
      // =====================================================================
      const BASELINE_PUF = Array.from({ length: 64 }, (_, i) => (0xA5 ^ (i * 13)) & 0xFF);

      const cassette = {
        security: {
          baseline: [...BASELINE_PUF],
          liveSample: [...BASELINE_PUF],
          sealIntact: true,
          sessionKey: '8F4C92E1B703A6D54410F98A91E4C02B',
          hammingDist: 2
        },
        scheduler: {
          masterLoad: 12,
          supercapSoc: 95,
          subNodes: Array.from({ length: 7 }, (_, i) => ({
            id: i,
            load: 10 + (i % 3) * 5,
            temp: 42 + (i % 2) * 2,
            health: 'Online' // 'Online' | 'Throttled' | 'Isolated'
          }))
        },
        ledger: {
          balance: 10000,
          sequence: 0,
          txCount: 0
        }
      };

      // Simulate minor 2-bit thermal noise on boot
      cassette.security.liveSample[0] ^= 0b00000011;

      function computeHammingDistance(a, b) {
        let dist = 0;
        for (let i = 0; i < a.length; i++) {
          let xor = a[i] ^ b[i];
          while (xor > 0) {
            dist += xor & 1;
            xor >>= 1;
          }
        }
        return dist;
      }

      // =====================================================================
      // 2. UI Rendering & Receipt Logging
      // =====================================================================
      const receiptFeed = document.getElementById('receipt-feed');

      function pushLog(title, detail, type = 'info') {
        const now = new Date();
        const ts = `${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}:${String(now.getSeconds()).padStart(2,'0')}`;
        const styles = {
          success: 'border-emerald-500/40 bg-emerald-950/30 text-emerald-300',
          warn: 'border-amber-500/40 bg-amber-950/30 text-amber-300',
          danger: 'border-rose-500/60 bg-rose-950/50 text-rose-300',
          info: 'border-slate-700 bg-slate-900/70 text-cyan-300'
        };
        const card = document.createElement('div');
        card.className = `p-2.5 rounded-lg border ${styles[type] || styles.info} leading-snug`;
        card.innerHTML = `
          <div class="flex justify-between text-[10px] opacity-75 mb-0.5">
            <span>${title}</span>
            <span>${ts}</span>
          </div>
          <div class="text-[11px] text-slate-200">${detail}</div>
        `;
        receiptFeed.prepend(card);
        if (receiptFeed.children.length > 25) {
          receiptFeed.removeChild(receiptFeed.lastChild);
        }
      }

      function renderPufMatrix() {
        const grid = document.getElementById('puf-hex-grid');
        grid.innerHTML = '';
        // Display first 16 bytes as representative hex grid
        for (let i = 0; i < 16; i++) {
          const byte = cassette.security.liveSample[i];
          const diff = byte !== cassette.security.baseline[i];
          const cell = document.createElement('div');
          cell.className = `py-0.5 rounded ${
            !cassette.security.sealIntact
              ? 'bg-rose-950 text-rose-400'
              : diff
              ? 'bg-amber-950/80 text-amber-300'
              : 'bg-slate-900 text-cyan-300'
          }`;
          cell.textContent = byte.toString(16).toUpperCase().padStart(2, '0');
          grid.appendChild(cell);
        }

        const hd = computeHammingDistance(cassette.security.baseline, cassette.security.liveSample);
        cassette.security.hammingDist = hd;
        const hdText = document.getElementById('puf-hd-text');
        hdText.textContent = `Hamming Dist: ${hd} / 4`;
        hdText.className = hd > 4 ? 'text-rose-400 font-bold' : 'text-emerald-400 font-bold';
      }

      function renderNodes() {
        const grid = document.getElementById('nodes-grid');
        grid.innerHTML = '';

        cassette.scheduler.subNodes.forEach((node, idx) => {
          const isIso = node.health === 'Isolated';
          const isThr = node.health === 'Throttled';

          const card = document.createElement('div');
          card.className = `cursor-pointer rounded-lg p-2 border text-center transition select-none ${
            isIso
              ? 'bg-rose-950/40 border-rose-500/60 opacity-70'
              : isThr
              ? 'bg-amber-950/40 border-amber-500/50'
              : 'bg-slate-900/90 border-cyan-500/40 hover:border-cyan-300'
          }`;

          const statusLabel = isIso ? 'ISO' : isThr ? 'LOW' : 'OK';
          const statusColor = isIso ? 'text-rose-400' : isThr ? 'text-amber-300' : 'text-emerald-400';

          card.innerHTML = `
            <div class="flex justify-between items-center text-[10px] font-mono-code">
              <span class="font-bold text-white">N${node.id}</span>
              <span class="${statusColor} font-bold">${statusLabel}</span>
            </div>
            <div class="my-1.5 text-sm font-mono-code font-bold ${isIso ? 'text-rose-400' : 'text-cyan-300'}">
              ${isIso ? 'ERR' : node.load + '%'}
            </div>
            <div class="w-full h-1.5 bg-slate-800 rounded-full overflow-hidden">
              <div class="h-full ${isIso ? 'bg-rose-500' : 'bg-cyan-400'} transition-all" style="width: ${isIso ? 100 : node.load}%"></div>
            </div>
            <div class="mt-1 text-[9px] font-mono-code text-slate-400">${node.temp}°C</div>
          `;

          card.addEventListener('click', () => {
            if (node.health === 'Isolated') {
              node.health = cassette.scheduler.supercapSoc < 35 ? 'Throttled' : 'Online';
              node.load = 10;
              pushLog(`NODE_RECOVERY // N${node.id}`, `子節點 N${node.id} 已解除隔離並重新併入 7:1 調度網格。`, 'success');
            } else {
              node.health = 'Isolated';
              node.load = 0;
              pushLog(`PARTIAL_ISSUE_ISOLATION // N${node.id}`, `觸發 targeting-partial_issue：異常子節點 N${node.id} 已硬體隔離。`, 'warn');
            }
            update3DNodes();
            renderNodes();
          });

          grid.appendChild(card);
        });

        document.getElementById('master-load').textContent = `${cassette.scheduler.masterLoad}%`;
      }

      function syncHeaderAndLedger() {
        document.getElementById('hdr-soc').textContent = `${cassette.scheduler.supercapSoc}%`;
        document.getElementById('hdr-credits').textContent = `${cassette.ledger.balance.toLocaleString()} uCR`;
        document.getElementById('ledger-bal').textContent = cassette.ledger.balance.toLocaleString();
        document.getElementById('ledger-seq').textContent = `SEQ #${cassette.ledger.sequence}`;
        document.getElementById('ledger-tx-count').textContent = `${cassette.ledger.txCount} TXs`;
      }

      // =====================================================================
      // 3. Security Attestation & Tamper Simulation
      // =====================================================================
      document.getElementById('btn-attest').addEventListener('click', () => {
        if (!cassette.security.sealIntact) {
          pushLog('ATTEST_REJECTED', '主動防篡改封條已熔斷！請先執行工廠 HSM 熔絲重置。', 'danger');
          return;
        }
        // Generate slight 1-3 bit natural thermal jitter
        cassette.security.liveSample = [...cassette.security.baseline];
        const bitFlip = Math.floor(Math.random() * 3);
        cassette.security.liveSample[0] ^= (1 << bitFlip);

        const newKey = Array.from({ length: 16 }, () =>
          Math.floor(Math.random() * 256).toString(16).toUpperCase().padStart(2, '0')
        ).join('');
        cassette.security.sessionKey = newKey;

        renderPufMatrix();
        document.getElementById('session-key-display').textContent = `0x${newKey.slice(0, 16)}...${newKey.slice(-8)}`;
        document.getElementById('hdr-seal').textContent = `BOUND (HD: ${cassette.security.hammingDist}-bit)`;
        pushLog('COAT_ID_ATTESTED', `物理塗層 PUF 遠端證明通過 (HD=${cassette.security.hammingDist} bits)，工作階段金鑰已輪換。`, 'success');
      });

      document.getElementById('btn-tamper').addEventListener('click', () => {
        if (!cassette.security.sealIntact) return;
        // Corrupt multiple bytes -> avalanche effect
        cassette.security.liveSample[2] ^= 0xFF;
        cassette.security.liveSample[5] ^= 0xF0;
        cassette.security.sealIntact = false;
        cassette.security.sessionKey = null;

        renderPufMatrix();
        document.getElementById('session-key-display').textContent = '0x0000000000000000 [ZEROIZED]';
        document.getElementById('badge-puf').textContent = 'BREACHED';
        document.getElementById('badge-puf').className = 'text-[10px] font-mono-code px-2 py-0.5 rounded bg-rose-950 text-rose-300 border border-rose-500 animate-pulse';

        document.getElementById('hdr-seal').textContent = 'BREACHED / LOCKED';
        document.getElementById('hdr-seal').className = 'text-rose-400 font-bold ml-1';
        document.getElementById('hdr-seal-box').className = 'px-3 py-1.5 rounded bg-rose-950/90 border border-rose-500';
        document.getElementById('status-dot').className = 'w-3 h-3 rounded-full bg-rose-500 animate-ping';
        document.getElementById('panel-security').classList.add('breached-glow');
        document.getElementById('btn-factory-reset').classList.remove('hidden');

        // Turn 3D shield red
        if (coatShieldMat) coatShieldMat.color.setHex(0xf43f5e);

        pushLog('TAMPER_SEAL_BREACHED', `偵測到外殼物理破壞 (HD=${cassette.security.hammingDist} > 4)！安全晶片已於 10μs 內銷毀所有金鑰並鎖死運算核心。`, 'danger');
      });

      document.getElementById('btn-factory-reset').addEventListener('click', () => {
        cassette.security.liveSample = [...cassette.security.baseline];
        cassette.security.liveSample[0] ^= 0b00000011;
        cassette.security.sealIntact = true;
        cassette.security.sessionKey = '8F4C92E1B703A6D54410F98A91E4C02B';

        renderPufMatrix();
        document.getElementById('session-key-display').textContent = '0x8F4C92E1B703A6D5...91E4C02B';
        document.getElementById('badge-puf').textContent = 'INTACT';
        document.getElementById('badge-puf').className = 'text-[10px] font-mono-code px-2 py-0.5 rounded bg-emerald-950 text-emerald-300 border border-emerald-500/40';

        document.getElementById('hdr-seal').textContent = 'BOUND (HD: 2-bit)';
        document.getElementById('hdr-seal').className = 'text-emerald-400 font-bold ml-1';
        document.getElementById('hdr-seal-box').className = 'px-3 py-1.5 rounded bg-slate-900/90 border border-emerald-500/50';
        document.getElementById('status-dot').className = 'w-3 h-3 rounded-full bg-emerald-400 animate-ping';
        document.getElementById('panel-security').classList.remove('breached-glow');
        document.getElementById('btn-factory-reset').classList.add('hidden');

        if (coatShieldMat) coatShieldMat.color.setHex(0x38bdf8);
        pushLog('HSM_FACTORY_RESET', 'HSM 熔絲基準指紋已重新註冊，零信任安全通道恢復運作。', 'success');
      });

      // =====================================================================
      // 4. Power & Drought Slider
      // =====================================================================
      const sliderSoc = document.getElementById('slider-soc');
      sliderSoc.addEventListener('input', () => {
        const soc = parseInt(sliderSoc.value, 10);
        cassette.scheduler.supercapSoc = soc;
        document.getElementById('val-soc').textContent = `${soc}%`;

        const badgePower = document.getElementById('badge-power');
        if (soc < 20) {
          badgePower.textContent = 'DROUGHT CRITICAL';
          badgePower.className = 'text-[10px] font-mono-code px-1.5 py-0.5 rounded bg-rose-950 text-rose-300 animate-pulse';
        } else if (soc < 35) {
          badgePower.textContent = 'THROTTLED';
          badgePower.className = 'text-[10px] font-mono-code px-1.5 py-0.5 rounded bg-amber-950 text-amber-300';
        } else {
          badgePower.textContent = '120W COUPLED';
          badgePower.className = 'text-[10px] font-mono-code px-1.5 py-0.5 rounded bg-cyan-950 text-cyan-300';
        }

        cassette.scheduler.subNodes.forEach(n => {
          if (n.health !== 'Isolated') {
            n.health = soc < 35 ? 'Throttled' : 'Online';
          }
        });

        renderNodes();
        syncHeaderAndLedger();
      });

      // =====================================================================
      // 5. Execute Zero-Trust Job (`execute_zero_trust_job`)
      // =====================================================================
      document.querySelectorAll('.btn-dispatch').forEach(btn => {
        btn.addEventListener('click', () => {
          const priority = btn.getAttribute('data-priority');

          // Step 1: Security Check
          if (!cassette.security.sealIntact || !cassette.security.sessionKey) {
            pushLog('ERR::UnboundSession', '拒絕執行：Coat-ID 安全工作階段未綁定或已熔斷。', 'danger');
            return;
          }

          // Step 2: Energy Drought Check
          if (cassette.scheduler.supercapSoc < 20 && priority !== 'PeriapsisCritical') {
            pushLog('ERR::EnergyDroughtCritical', `超級電容電量過低 (${cassette.scheduler.supercapSoc}%)，僅允許近地點緊急任務。`, 'warn');
            return;
          }

          // Step 3: Tangent Summit Node Selection
          const loadMap = { PeriapsisCritical: 25, StandardOrbit: 20, ApoapsisBatch: 15 };
          const costMap = { PeriapsisCritical: 150, StandardOrbit: 100, ApoapsisBatch: 80 };
          const reqLoad = loadMap[priority];
          const reqCost = costMap[priority];

          if (cassette.ledger.balance < reqCost) {
            pushLog('ERR::InsufficientCredits', 'Cash-Portal 算力信用餘額不足，請先儲值。', 'warn');
            return;
          }

          let bestNode = null;
          let minCost = Infinity;
          cassette.scheduler.subNodes.forEach(n => {
            if (n.health === 'Isolated') return;
            if (n.health === 'Throttled' && priority === 'ApoapsisBatch') return;
            if (n.load + reqLoad > 95) return;
            const score = n.load * 2 + Math.max(0, n.temp - 50);
            if (score < minCost) {
              minCost = score;
              bestNode = n;
            }
          });

          if (!bestNode) {
            pushLog('ERR::NoAvailableSubNode', '7:1 陣列無可用子節點（全數滿載或隔離中）。', 'warn');
            return;
          }

          // Apply dispatch & settle
          bestNode.load = Math.min(95, bestNode.load + reqLoad);
          bestNode.temp += Math.floor(reqLoad / 8);
          cassette.scheduler.masterLoad = Math.min(100, cassette.scheduler.masterLoad + 1);

          cassette.ledger.balance -= reqCost;
          cassette.ledger.sequence += 1;
          cassette.ledger.txCount += 1;

          const macHex = Math.floor(0x10000000 + Math.random() * 0x8FFFFFFF).toString(16).toUpperCase();

          pushLog(
            `RECEIPT #${cassette.ledger.sequence} ➔ Node N${bestNode.id}`,
            `[${priority}] 扣款 <b>${reqCost} uCR</b> | 餘額 ${cassette.ledger.balance} | MAC: 0x${macHex}`,
            'success'
          );

          pulseNode3D(bestNode.id);
          renderNodes();
          syncHeaderAndLedger();
        });
      });

      document.getElementById('btn-topup').addEventListener('click', () => {
        cassette.ledger.balance += 5000;
        syncHeaderAndLedger();
        pushLog('CASH_PORTAL_TOPUP', '狀態通道已儲值 +5,000 uCR 算力信用額度。', 'info');
      });

      document.getElementById('btn-clear-feed').addEventListener('click', () => {
        receiptFeed.innerHTML = '';
      });

      // Natural cooling & load decay tick
      setInterval(() => {
        let totalSubLoad = 0;
        cassette.scheduler.subNodes.forEach(n => {
          if (n.health !== 'Isolated') {
            n.load = Math.max(8, n.load - 3);
            n.temp = Math.max(40, n.temp - 1);
            totalSubLoad += n.load;
          }
        });
        cassette.scheduler.masterLoad = Math.max(10, cassette.scheduler.masterLoad - 1);
        renderNodes();

        // Update chart
        const avgSub = Math.round(totalSubLoad / 7);
        subLoadHistory.push(avgSub);
        subLoadHistory.shift();
        masterLoadHistory.push(cassette.scheduler.masterLoad);
        masterLoadHistory.shift();
        loadChart.update();
      }, 1500);

      // =====================================================================
      // 6. Chart.js Telemetry
      // =====================================================================
      const subLoadHistory = Array.from({ length: 16 }, () => 18);
      const masterLoadHistory = Array.from({ length: 16 }, () => 12);
      const loadChart = new Chart(document.getElementById('loadChart').getContext('2d'), {
        type: 'line',
        data: {
          labels: Array.from({ length: 16 }, (_, i) => i),
          datasets: [
            {
              label: '7x NPU 平均負載 (%)',
              data: subLoadHistory,
              borderColor: '#38bdf8',
              backgroundColor: 'rgba(56, 189, 248, 0.15)',
              fill: true,
              tension: 0.35,
              pointRadius: 0
            },
            {
              label: '1x Master 主控開銷 (%)',
              data: masterLoadHistory,
              borderColor: '#10b981',
              borderDash: [4, 4],
              tension: 0.35,
              pointRadius: 0
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: false,
          scales: {
            x: { display: false },
            y: {
              min: 0,
              max: 100,
              grid: { color: 'rgba(148, 163, 184, 0.12)' },
              ticks: { color: '#94a3b8', font: { size: 10 } }
            }
          },
          plugins: {
            legend: { labels: { color: '#cbd5e1', font: { size: 10 }, boxWidth: 10 } }
          }
        }
      });

      // =====================================================================
      // 7. Three.js 3D Cassette Hardware Twin
      // =====================================================================
      const container = document.getElementById('webgl-cassette');
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 100);
      camera.position.set(0, 6.2, 8.2);
      camera.lookAt(0, 0, 0);

      const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setSize(container.clientWidth, container.clientHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      container.appendChild(renderer.domElement);

      scene.add(new THREE.AmbientLight(0x38bdf8, 0.75));
      const dirLight = new THREE.DirectionalLight(0xffffff, 1.1);
      dirLight.position.set(5, 10, 7);
      scene.add(dirLight);

      const cassetteGroup = new THREE.Group();
      scene.add(cassetteGroup);

      // PCB Substrate
      const pcbGeo = new THREE.BoxGeometry(6.2, 0.18, 4.0);
      const pcbMat = new THREE.MeshStandardMaterial({ color: 0x0f172a, metalness: 0.7, roughness: 0.3 });
      const pcbMesh = new THREE.Mesh(pcbGeo, pcbMat);
      cassetteGroup.add(pcbMesh);

      // Wireless Power Induction Coil (Bottom Ring)
      const coilGeo = new THREE.TorusGeometry(1.5, 0.08, 16, 48);
      const coilMat = new THREE.MeshBasicMaterial({ color: 0xf59e0b });
      const coilMesh = new THREE.Mesh(coilGeo, coilMat);
      coilMesh.rotation.x = Math.PI / 2;
      coilMesh.position.y = -0.22;
      cassetteGroup.add(coilMesh);

      // Master Core (Center Emerald Chip)
      const masterChipGeo = new THREE.BoxGeometry(1.1, 0.28, 1.1);
      const masterChipMat = new THREE.MeshStandardMaterial({
        color: 0x10b981,
        emissive: 0x059669,
        emissiveIntensity: 0.6
      });
      const masterChip = new THREE.Mesh(masterChipGeo, masterChipMat);
      masterChip.position.set(0, 0.22, 0);
      cassetteGroup.add(masterChip);

      // 7 Sub-Node NPU Chips arranged around Master Core
      const nodeMeshes = [];
      const positions7 = [
        [-2.0, -1.1], [0, -1.35], [2.0, -1.1],
        [-2.1, 0.9], [-0.7, 1.3], [0.7, 1.3], [2.1, 0.9]
      ];
      positions7.forEach(([x, z], idx) => {
        const geo = new THREE.BoxGeometry(0.68, 0.22, 0.68);
        const mat = new THREE.MeshStandardMaterial({
          color: 0x38bdf8,
          emissive: 0x0284c7,
          emissiveIntensity: 0.5
        });
        const m = new THREE.Mesh(geo, mat);
        m.position.set(x, 0.2, z);
        cassetteGroup.add(m);
        nodeMeshes.push(m);
      });

      // Outer Coat-ID PUF Wireframe Casing
      const casingGeo = new THREE.BoxGeometry(6.6, 0.85, 4.4);
      const coatShieldMat = new THREE.MeshBasicMaterial({
        color: 0x38bdf8,
        wireframe: true,
        transparent: true,
        opacity: 0.25
      });
      const casingMesh = new THREE.Mesh(casingGeo, coatShieldMat);
      casingMesh.position.y = 0.1;
      cassetteGroup.add(casingMesh);

      function update3DNodes() {
        cassette.scheduler.subNodes.forEach((n, idx) => {
          const mat = nodeMeshes[idx].material;
          if (n.health === 'Isolated') {
            mat.color.setHex(0xf43f5e);
            mat.emissive.setHex(0xe11d48);
          } else if (n.health === 'Throttled') {
            mat.color.setHex(0xf59e0b);
            mat.emissive.setHex(0xd97706);
          } else {
            mat.color.setHex(0x38bdf8);
            mat.emissive.setHex(0x0284c7);
          }
        });
      }

      function pulseNode3D(idx) {
        const m = nodeMeshes[idx];
        if (!m) return;
        m.scale.set(1.3, 1.8, 1.3);
        setTimeout(() => m.scale.set(1, 1, 1), 350);
      }

      // Mouse drag rotation
      let dragging = false;
      let prev = { x: 0, y: 0 };
      let rotY = 0.25;
      let rotX = 0.1;

      renderer.domElement.addEventListener('mousedown', e => {
        dragging = true;
        prev = { x: e.clientX, y: e.clientY };
      });
      window.addEventListener('mouseup', () => { dragging = false; });
      window.addEventListener('mousemove', e => {
        if (!dragging) return;
        rotY += (e.clientX - prev.x) * 0.008;
        rotX = Math.max(-0.5, Math.min(0.6, rotX + (e.clientY - prev.y) * 0.008));
        prev = { x: e.clientX, y: e.clientY };
      });

      function animate() {
        requestAnimationFrame(animate);
        if (!dragging) rotY += 0.003;
        cassetteGroup.rotation.y += (rotY - cassetteGroup.rotation.y) * 0.1;
        cassetteGroup.rotation.x += (rotX - cassetteGroup.rotation.x) * 0.1;
        renderer.render(scene, camera);
      }
      animate();

      window.addEventListener('resize', () => {
        if (!container) return;
        camera.aspect = container.clientWidth / container.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(container.clientWidth, container.clientHeight);
      });

      // Initial Boot Render
      renderPufMatrix();
      renderNodes();
      syncHeaderAndLedger();
      pushLog('SYSTEM_BOOT // M0', 'AEGIS-CASSETTE M0 韌體狀態機初始化完成，Coat-ID 驗證通過。', 'success');
    });
  </script>
</body>
</html>
